# Bridge Ministries International — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.

APP_ENV=development
APP_URL=http://localhost/BMI
APP_DEBUG=true

DB_HOST=localhost
DB_PORT=3306
DB_NAME=church_website
DB_USER=root
DB_PASS=

# Used to sign session cookies / CSRF tokens. Generate with `openssl rand -hex 32`.
APP_SECRET=change-me-to-a-long-random-string

# Mail settings (for contact form notifications). Leave blank to disable.
# Email: smtp (recommended), mail, or log (writes to logs/ instead of sending; for local development)
MAIL_TRANSPORT=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME="Bridge Ministries International"
MAIL_FROM=info@bmiglobal.org
MAIL_TO=info@bmiglobal.org

# Paystack keys for online giving. Get these from https://dashboard.paystack.com
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# ChMS Payment Portal URL for one-tap giving redirects
CHMS_PAYMENT_URL=

# Plausible Analytics domain (e.g., bmiglobal.org). Leave blank to disable.
ANALYTICS_DOMAIN=

# Database backups: a folder OUTSIDE the website (e.g. /home/USER/bmi-backups)
BACKUP_DIR=
BACKUP_KEEP_DAYS=30

# Receives an email when the site logs an error (at most one per hour). Leave empty to disable.
ALERT_EMAIL=

# Contact, prayer and visit messages are deleted after this many months (see Privacy Policy)
MESSAGE_RETENTION_MONTHS=24

# Church time zone for all times entered in the admin
APP_TIMEZONE=Africa/Accra

# true only when the site is behind Cloudflare (uses its visitor IP and country headers)
TRUST_CLOUDFLARE=false
