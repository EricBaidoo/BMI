# Bridge Ministries International — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.

APP_ENV=development
APP_URL=http://localhost/BMI
APP_DEBUG=true

DB_HOST=localhost
DB_PORT=3306
DB_NAME=church_website
DB_USER=root
DB_PASS=

# Used to sign session cookies / CSRF tokens. Generate with `openssl rand -hex 32`.
APP_SECRET=change-me-to-a-long-random-string

# Mail settings (for contact form notifications). Leave blank to disable.
MAIL_FROM=info@bmiglobal.org
MAIL_TO=info@bmiglobal.org

# Paystack keys for online giving. Get these from https://dashboard.paystack.com
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Plausible Analytics domain (e.g., bmiglobal.org). Leave blank to disable.
ANALYTICS_DOMAIN=
