# Environment / secrets
.env
.env.*
!.env.example

# Database dumps and data exports — keep these outside the web root
*.sql
!database/schema.sql
*.sql.gz
*dump*.txt

# Claude Code local settings
.claude/

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp
*~

# Build artefacts
node_modules/
/public/assets/css/styles.tailwind.css

# Logs
*.log

# User uploads (event/sermon images get committed by mistake otherwise)
/public/assets/image/event_*
/public/assets/image/sermon_*

# Application logs
/logs/

# Composer dependencies (run composer install on each server)
/vendor/
