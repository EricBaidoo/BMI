{
    "name": "bmi/website",
    "description": "Bridge Ministries International public website",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-gd": "*",
        "ext-dom": "*",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        }
    },
    "scripts": {
        "lint": "php bin/lint.php",
        "analyse": "phpstan analyse --memory-limit=512M",
        "smoke": "php bin/smoke-test.php",
        "test": ["@lint", "@analyse"]
    }
}
