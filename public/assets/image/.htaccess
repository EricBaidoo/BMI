# Uploaded media only: never execute or serve scripts or markup from this folder.
<FilesMatch "\.(php[0-9]?|phtml|phar|pht|pl|py|cgi|sh|shtml|s?html?|svgz?|js|htaccess)$">
    Require all denied
</FilesMatch>
<IfModule mod_mime.c>
    RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
    RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
</IfModule>
Options -Indexes -ExecCGI
