# Bridge Ministries International — Apache configuration

# ------------------------------------------------------------------------------
# Default character set
# ------------------------------------------------------------------------------
AddDefaultCharset utf-8

# ------------------------------------------------------------------------------
# URL rewrites
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # This folder is served at the site root. Its own name never appears in addresses,
    # so /public/... is refused rather than becoming a second copy of every page.
    RewriteCond %{THE_REQUEST} \s/+([^?\s]*/)?public(/|[?\s]) [NC]
    RewriteRule ^ - [R=404,L]

    # Map /sitemap.xml to sitemap.php
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # robots.txt is generated so its sitemap address is absolute on every server
    RewriteRule ^robots\.txt$ robots.php [L]

    # Block direct access to dotfiles (.env, .git, etc.)
    RewriteRule "(^|/)\." - [F]

    # ------------------------------------------------------------------
    # Hide .php extensions on public pages (admin/ keeps .php as-is)
    # ------------------------------------------------------------------

    # Redirect index.php to directory root (dynamic)
    RewriteCond %{REQUEST_URI} !/admin/ [NC]
    RewriteCond %{THE_REQUEST} \s/+([^?\s]*/)?index(?:\.php)?[?\s] [NC]
    RewriteRule ^ /%1 [R=301,L]

    # Redirect any visible /something.php -> /something (dynamic).
    # Skipped for admin/: its forms post to .php URLs, and a redirect would turn a POST into a GET.
    RewriteCond %{REQUEST_URI} !/admin/ [NC]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.php([?\s]) [NC]
    RewriteRule ^ /%1 [R=301,L,NE,QSA]

    # Internally rewrite /something -> /something.php when the file exists
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [L]
</IfModule>

# ------------------------------------------------------------------------------
# Custom error pages
# ------------------------------------------------------------------------------
# Make sure to change this to /404.php on your live server!
ErrorDocument 404 /404.php

# ------------------------------------------------------------------------------
# Security headers
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header unset X-Powered-By
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # HSTS — only enable once site is fully on HTTPS:
    # Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Loose CSP — adjust as third-party origins are added (Plausible, Paystack, YouTube, etc.)
    Header set Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.tailwindcss.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://js.paystack.co https://plausible.io https://cdn.jsdelivr.net https://unpkg.com https://cdnjs.cloudflare.com; frame-src https://www.youtube.com https://www.google.com https://www.facebook.com https://checkout.paystack.com; connect-src 'self' https://api.paystack.co https://plausible.io"
</IfModule>

# ------------------------------------------------------------------------------
# Block direct access to sensitive files
# ------------------------------------------------------------------------------
<FilesMatch "^(\.env|\.gitignore|composer\.(json|lock)|package\.json|package-lock\.json|README\.md|tailwind\.config\.js)$">
    Require all denied
</FilesMatch>

# Database dumps, backups, logs, notes and text files are never served
<FilesMatch "\.(sql|gz|zip|bak|old|log|md|txt|ini|sh)$">
    Require all denied
</FilesMatch>
# robots.txt must stay public
<Files "robots.txt">
    Require all granted
</Files>


# ------------------------------------------------------------------------------
# Compression
# ------------------------------------------------------------------------------
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

# ------------------------------------------------------------------------------
# Browser caching
# CSS/JS links carry ?v=<file time>, so they can be cached for a year: a change gets a new URL.
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/avif "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType video/mp4 "access plus 1 month"
    ExpiresByType video/webm "access plus 1 month"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(jpe?g|png|webp|avif|gif|ico|svg|mp4|webm)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

# Disable directory listing
Options -Indexes
